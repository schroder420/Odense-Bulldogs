# Server only. Never prefix these with NEXT_PUBLIC_.
SUPABASE_URL=
# Supabase's Vercel integration may call these NEXT_PUBLIC_SUPABASE_URL and SUPABASE_SECRET_KEY.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=
# Generate each independently: openssl rand -hex 32
SESSION_SECRET=
ADMIN_PASSWORD=
# Exact public HTTPS origin, no trailing slash. Required in production.
APP_ORIGIN=http://localhost:3000
# Practice mode is available without a backend. Competitive mode fails closed.
